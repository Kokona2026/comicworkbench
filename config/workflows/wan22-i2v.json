{
  "__meta__": {
    "title": "Wan 2.2 I2V A14B - image to video (5s clip)",
    "stage": 5,
    "requires_packs": ["ComfyUI-GGUF", "KJNodes", "VideoHelperSuite"],
    "notes": "Stage 5 is optional. GGUF loader comes from ComfyUI-GGUF; swap node 1 to UNETLoader when using a safetensors build. Measure both 4-step and 8-step: on some GPUs 4 steps is slower than 8.",
    "defaults": {
      "unet_name": "wan2.2-i2v-a14b-Q8_0.gguf",
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "vae_name": "wan_2.1_vae.safetensors",
      "lora_name": "lightx2v_I2V_14B_480p.safetensors",
      "strength_model": 1.0,
      "start_image": "frame001.png",
      "width": 832,
      "height": 480,
      "length": 81,
      "shift": 5.0,
      "seed": 123456789,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "positive": "The girl turns her head and smiles softly, her hair sways in the wind, slow camera push-in, warm sunset light.",
      "negative": "",
      "frame_rate": 16,
      "filename_prefix": "anima/wan22"
    }
  },
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "{{unet_name}}" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "{{clip_name}}", "type": "wan", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{vae_name}}" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{start_image}}" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{positive}}", "clip": ["2", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{negative}}", "clip": ["2", 0] }
  },
  "7": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["3", 0],
      "start_image": ["4", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{length}}",
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": "{{shift}}" }
  },
  "9": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "lora_name": "{{lora_name}}", "strength_model": "{{strength_model}}", "model": ["8", 0] }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "denoise": "{{denoise}}",
      "model": ["9", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent_image": ["7", 2]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] }
  },
  "12": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["11", 0],
      "frame_rate": "{{frame_rate}}",
      "loop_count": 0,
      "filename_prefix": "{{filename_prefix}}",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
